<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.kashtakala.fragments.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splash_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.kashtakala.fragments.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_signup"
            app:destination="@id/signupFragment" />
    </fragment>

    <fragment
        android:id="@+id/signupFragment"
        android:name="com.example.kashtakala.fragments.SignupFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signup_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.kashtakala.fragments.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_home_to_estimator"
            app:destination="@id/estimatorFragment" />
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_home_to_booking"
            app:destination="@id/bookingFragment" />
        <action
            android:id="@+id/action_home_to_sales"
            app:destination="@id/salesFragment" />
        <action
            android:id="@+id/action_home_to_favorite"
            app:destination="@id/favoriteFragment" />
    </fragment>

    <fragment
        android:id="@+id/catalogFragment"
        android:name="com.example.kashtakala.fragments.CatalogFragment"
        android:label="Catalog"
        tools:layout="@layout/fragment_catalog">
        <argument
            android:name="category"
            app:argType="string"
            android:defaultValue="All" />
        <action
            android:id="@+id/action_catalog_to_detail"
            app:destination="@id/detailFragment" />
        <action
            android:id="@+id/action_catalog_to_estimator"
            app:destination="@id/estimatorFragment" />
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.example.kashtakala.fragments.DetailFragment"
        android:label="Detail"
        tools:layout="@layout/fragment_detail">
        <action
            android:id="@+id/action_detail_to_estimator"
            app:destination="@id/estimatorFragment" />
        <action
            android:id="@+id/action_detail_to_visualizer"
            app:destination="@id/visualizerFragment" />
    </fragment>

    <fragment
        android:id="@+id/estimatorFragment"
        android:name="com.example.kashtakala.fragments.EstimatorFragment"
        android:label="Estimator"
        tools:layout="@layout/fragment_estimator">
        <argument
            android:name="length"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="width"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="height"
            app:argType="float"
            android:defaultValue="0.0" />
        <action
            android:id="@+id/action_estimator_to_quotation"
            app:destination="@id/quotationFragment" />
    </fragment>

    <fragment
        android:id="@+id/quotationFragment"
        android:name="com.example.kashtakala.fragments.QuotationFragment"
        android:label="Quotation"
        tools:layout="@layout/fragment_quotation" />

    <fragment
        android:id="@+id/portfolioFragment"
        android:name="com.example.kashtakala.fragments.PortfolioFragment"
        android:label="Portfolio"
        tools:layout="@layout/fragment_portfolio" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.kashtakala.fragments.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">
        <action
            android:id="@+id/action_settings_to_profile"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_settings_to_booking"
            app:destination="@id/bookingFragment" />
        <action
            android:id="@+id/action_settings_to_sales"
            app:destination="@id/salesFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.kashtakala.fragments.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.kashtakala.fragments.BookingFragment"
        android:label="Bookings"
        tools:layout="@layout/fragment_booking" />

    <fragment
        android:id="@+id/salesFragment"
        android:name="com.example.kashtakala.fragments.SalesFragment"
        android:label="Sales"
        tools:layout="@layout/fragment_sales" />

    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.example.kashtakala.fragments.FavoriteFragment"
        android:label="Favorites"
        tools:layout="@layout/fragment_favorite" />

    <fragment
        android:id="@+id/visualizerFragment"
        android:name="com.example.kashtakala.fragments.VisualizerFragment"
        android:label="Visualizer"
        tools:layout="@layout/fragment_visualizer">
        <argument
            android:name="designId"
            app:argType="integer" />
    </fragment>

</navigation>